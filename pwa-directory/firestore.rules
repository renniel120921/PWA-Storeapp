rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // =========================================================================
    // Reusable Rule Helper Functions
    // =========================================================================

    // Check if the request is from an authenticated user
    function isAuthenticated() {
      return request.auth != null && request.auth.uid != null;
    }

    // Check if the authenticated user's UID matches the given userId
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Check if the user document in Firestore has the 'admin' role
    function isAdmin() {
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin";
    }

    // Check if the user document in Firestore has the 'developer' role
    function isDeveloper() {
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "developer";
    }

    // Check if the user document in Firestore has either 'developer' or 'admin' role
    function isDeveloperOrAdmin() {
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ["developer", "admin"];
    }

    // Validate allowed user roles
    function isValidUserRole(role) {
      return role == "user" || role == "developer" || role == "admin";
    }

    // Validate allowed PWA status values
    function isValidPwaStatus(status) {
      return status in ["draft", "pending", "approved", "rejected", "suspended"];
    }

    // =========================================================================
    // 1. Users Collection (/users/{userId})
    // =========================================================================
    match /users/{userId} {
      // User Privacy: Only the owner or an admin may read private profile data
      allow read: if isOwner(userId) || isAdmin();

      // Creation: Authenticated user can only create their own user document for legitimate registration.
      // - Must match auth UID.
      // - Role may ONLY be 'user' or 'developer' (client assignment of 'admin' is strictly blocked).
      // - Email must be a string.
      // - Strictly restricts document fields to allowed signup/profile keys using hasOnly().
      // - Protected fields (isVerified, admin privileges, custom claims, arbitrary fields) are blocked.
      allow create: if isOwner(userId)
        && request.resource.data.uid == userId
        && request.resource.data.email is string
        && (request.resource.data.role == "user" || request.resource.data.role == "developer")
        && request.resource.data.keys().hasOnly([
          'uid',
          'email',
          'firstName',
          'middleName',
          'lastName',
          'extensionName',
          'fullName',
          'role',
          'avatarUrl',
          'bio',
          'website',
          'createdAt',
          'updatedAt'
        ]);

      // Update:
      // - Admin has full update capability.
      // - Account Owner can ONLY update explicitly allowed self-editable profile fields:
      //   [firstName, middleName, lastName, extensionName, fullName, avatarUrl, bio, website, role, updatedAt].
      // - Protected fields (uid, email, createdAt, isVerified, and future privilege fields) CANNOT be altered.
      // - Role transition: Exactly one client transition permitted: ONLY "user" -> "developer".
      // - Setting role to "admin" or demoting "developer" -> "user" on client is strictly blocked.
      allow update: if isAdmin() || (
        isOwner(userId)
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.email == resource.data.email
        && (!('createdAt' in resource.data) || request.resource.data.createdAt == resource.data.createdAt)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'firstName',
          'middleName',
          'lastName',
          'extensionName',
          'fullName',
          'avatarUrl',
          'bio',
          'website',
          'role',
          'updatedAt'
        ])
        && (
          // Role is unchanged (standard profile field edit)
          (request.resource.data.role == resource.data.role) ||
          // Explicit self-service upgrade: ONLY "user" -> "developer"
          (resource.data.role == "user" && request.resource.data.role == "developer")
        )
        // Strictly forbid setting role to admin on client
        && request.resource.data.role != "admin"
      );

      // Deletion: Admin only
      allow delete: if isAdmin();
    }

    // =========================================================================
    // 2. PWAs Collection (/pwas/{slug})
    // =========================================================================
    match /pwas/{slug} {
      // Public read allowed ONLY for approved listings.
      // Admins and owning developers can read their own listings regardless of status.
      allow read: if resource.data.status == "approved"
        || isAdmin()
        || (isDeveloperOrAdmin() && resource.data.developerId == request.auth.uid);

      // Direct client creation is blocked (Only Admin / Server Route Handlers create master PWA docs)
      allow create: if isAdmin();

      // Updates:
      // - Admin has full update capability.
      // - Developer can update content metadata on their own approved app,
      //   but CANNOT change developerId, slug, status, viewsCount, clicksCount, ratingAverage, or ratingCount.
      // - Normal 'user' role is strictly rejected from mutating PWA documents.
      allow update: if isAdmin() || (
        isDeveloperOrAdmin()
        && resource.data.developerId == request.auth.uid
        && request.resource.data.developerId == resource.data.developerId
        && request.resource.data.slug == resource.data.slug
        && request.resource.data.status == resource.data.status
        && (!('viewsCount' in request.resource.data) || request.resource.data.viewsCount == resource.data.viewsCount)
        && (!('clicksCount' in request.resource.data) || request.resource.data.clicksCount == resource.data.clicksCount)
        && (!('ratingAverage' in request.resource.data) || request.resource.data.ratingAverage == resource.data.ratingAverage)
        && (!('ratingCount' in request.resource.data) || request.resource.data.ratingCount == resource.data.ratingCount)
      );

      // Deletions: Developer Owner or Admin
      allow delete: if isAdmin() || (
        isDeveloperOrAdmin() && resource.data.developerId == request.auth.uid
      );
    }

    // =========================================================================
    // 3. Submissions Collection (/submissions/{submissionId})
    // =========================================================================
    match /submissions/{submissionId} {
      // Read: Admin or the submitting developer (normal users cannot read submissions)
      allow read: if isAdmin() || (
        isDeveloperOrAdmin() && resource.data.developerId == request.auth.uid
      );

      // Create: Authenticated developer/admin creating a 'draft' submission for themselves (normal users rejected)
      allow create: if isDeveloperOrAdmin()
        && request.resource.data.developerId == request.auth.uid
        && request.resource.data.status == "draft";

      // Update:
      // - Admin can update submissions (for reviews, status changes).
      // - Developer can edit draft submissions or reset rejected submissions back to draft.
      // - Developer CANNOT change developerId or directly set status to 'pending' or 'approved'.
      // - Normal 'user' role is strictly rejected from modifying submissions.
      allow update: if isAdmin() || (
        isDeveloperOrAdmin()
        && resource.data.developerId == request.auth.uid
        && request.resource.data.developerId == resource.data.developerId
        && (resource.data.status == "draft" || resource.data.status == "rejected")
        && request.resource.data.status == "draft"
      );

      // Delete: Developer can delete own draft submissions; Admin can delete any
      allow delete: if isAdmin() || (
        isDeveloperOrAdmin()
        && resource.data.developerId == request.auth.uid
        && resource.data.status == "draft"
      );
    }

    // =========================================================================
    // 4. Categories Collection (/categories/{categoryId})
    // =========================================================================
    match /categories/{categoryId} {
      // Public taxonomy is readable by all visitors
      allow read: if true;

      // Management restricted to Admins
      allow write: if isAdmin();
    }

    // =========================================================================
    // 5. Reviews Collection (/reviews/{reviewId})
    // =========================================================================
    match /reviews/{reviewId} {
      // Public can read published reviews; Admins and authors can read their own
      allow read: if resource.data.status == "published"
        || isAdmin()
        || (isAuthenticated() && resource.data.userId == request.auth.uid);

      // Direct client writes are blocked.
      // All review creations, updates, and aggregate calculations are performed
      // exclusively via server-side API (/api/reviews) using the Firebase Admin SDK.
      allow create, update, delete: if false;
    }

    // =========================================================================
    // 6. Favorites Collection (/favorites/{favId}) [Phase 2 Ready]
    // =========================================================================
    match /favorites/{favId} {
      // Users can only read and manage their own bookmarks
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;

      allow create: if isAuthenticated()
        && request.resource.data.userId == request.auth.uid
        && (
          (('pwaSlug' in request.resource.data) && favId == request.auth.uid + "_" + request.resource.data.pwaSlug) ||
          (('pwaId' in request.resource.data) && favId == request.auth.uid + "_" + request.resource.data.pwaId)
        );

      allow delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }

    // =========================================================================
    // 7. App Reports Collection (/appReports/{reportId}) [Phase 2 Ready]
    // =========================================================================
    match /appReports/{reportId} {
      // Direct client creation disabled to prevent spam/abuse.
      // Moderation reports are submitted exclusively via server-side API (/api/reports/submit)
      // using the Firebase Admin SDK.
      allow read, write: if isAdmin();
    }

    // =========================================================================
    // 8. Notifications Collection (/notifications/{notificationId})
    // =========================================================================
    match /notifications/{notificationId} {
      // Users can only read notifications addressed to them; Admins can read all/own
      allow read: if isAuthenticated() && (resource.data.recipientId == request.auth.uid || isAdmin());

      // Direct client creation is blocked (Created exclusively by Server API via Admin SDK)
      allow create: if false;

      // Update: Users can only update the 'read' flag on their own notifications
      allow update: if isAuthenticated()
        && resource.data.recipientId == request.auth.uid
        && request.resource.data.recipientId == resource.data.recipientId
        && request.resource.data.type == resource.data.type
        && request.resource.data.title == resource.data.title
        && request.resource.data.message == resource.data.message
        && request.resource.data.relatedId == resource.data.relatedId
        && request.resource.data.relatedType == resource.data.relatedType
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.read is bool;

      // Deletion: Notification recipient or Admin
      allow delete: if isAuthenticated() && (resource.data.recipientId == request.auth.uid || isAdmin());
    }
  }
}
